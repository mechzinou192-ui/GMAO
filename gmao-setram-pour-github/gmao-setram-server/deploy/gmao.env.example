# /etc/gmao-setram/gmao.env  — droits : chown root:gmao, chmod 640   (contient des secrets)
NODE_ENV=production
PORT=3000
HOST=127.0.0.1                      # le reverse proxy (nginx) est sur la même machine : le port 3000 reste local
DATABASE_URL=postgres://gmao:MOT_DE_PASSE_BASE@127.0.0.1:5432/gmao
JWT_SECRET=GENERER_48_OCTETS_ALEATOIRES    # openssl rand -base64 48 | tr -d '\n'
COOKIE_SECURE=true                  # HTTPS obligatoire
TRUST_PROXY=1                       # 1 = un reverse proxy devant l'application
FILES_DIR=/var/lib/gmao-setram/files
SESSION_HOURS=8
# Mot de passe du compte « admin » créé au 1er démarrage (changement exigé à la 1re connexion).
# Si absent : généré au hasard et affiché UNE fois dans le journal (journalctl -u gmao).
#ADMIN_INITIAL_PASSWORD=
# NE JAMAIS définir DEMO=1 en exploitation.
