# =====================================================================================
# GMAO SETRAM — variables d'environnement (installation Docker Compose)
#   1. cp .env.example .env        2. remplacer TOUTES les valeurs « changez-moi »
#   3. docker compose up -d --build
# Le fichier .env contient des secrets : ne jamais le committer (il est dans .gitignore),
# droits recommandés : chmod 600 .env
# L'application REFUSE de démarrer si un secret manque, est trop court ou vaut encore « changez-moi ».
# Installation sans Docker : voir deploy/gmao.env.example (mêmes variables + DATABASE_URL, HOST, FILES_DIR).
# =====================================================================================

# ---------- Obligatoires (secrets) ----------
# Mot de passe de la base PostgreSQL (utilisé par le conteneur db ET par l'application).
DB_PASSWORD=changez-moi-mot-de-passe-base
# Clé de signature des sessions : 32 caractères minimum, aléatoire.  Générer : openssl rand -base64 48 | tr -d '\n'
JWT_SECRET=changez-moi-generer-avec-openssl-rand-base64-48

# ---------- Réseau ----------
# Nom DNS sous lequel les postes joignent la GMAO (certificat HTTPS émis pour ce nom par Caddy).
GMAO_HOST=gmao.setram.local

# ---------- Compte administrateur initial ----------
# Mot de passe du compte « admin » créé au 1er démarrage (changement exigé à la 1re connexion).
# Laisser vide : un mot de passe aléatoire est généré et affiché UNE fois dans « docker compose logs app ».
ADMIN_INITIAL_PASSWORD=

# ---------- Session ----------
# Durée d'une session en heures (défaut 8).
SESSION_HOURS=8

# ---------- Journaux ----------
# Niveau : debug | info | warn | error (défaut info). Journaux au format JSON, un événement par ligne.
LOG_LEVEL=info

# ---------- Limitation de débit (anti-abus) — valeurs par défaut adaptées à 7 unités ----------
# Fenêtre de comptage en secondes pour les limites globale, écritures et coûteuses.
RATE_LIMIT_WINDOW_SEC=60
# Requêtes par fenêtre et par utilisateur connecté (sinon par adresse IP) sur toute l'API.
# Un poste ouvert consomme ~70 requêtes/minute (actualisation automatique des listes).
RATE_LIMIT_GLOBAL_MAX=600
# Écritures (création, modification, suppression) par fenêtre et par utilisateur.
RATE_LIMIT_WRITE_MAX=300
# Opérations coûteuses (import Excel, envoi de photos) par fenêtre et par utilisateur.
RATE_LIMIT_COSTLY_MAX=30
# Tentatives de connexion par adresse IP et par fenêtre (en minutes). En plus : verrouillage du COMPTE 15 min après 5 échecs.
RATE_LIMIT_AUTH_WINDOW_MIN=15
RATE_LIMIT_AUTH_MAX=30

# ---------- Unités ----------
# Liste des unités opérationnelles, séparées par des virgules (vide = Alger, Oran, Constantine, Sidi Bel Abbès, Ouargla, Sétif, Mostaganem).
UNITS=

# ---------- Arrêt ----------
# Délai (secondes) laissé aux requêtes en cours lors d'un arrêt / redémarrage avant arrêt forcé.
SHUTDOWN_TIMEOUT_SEC=10

# ---------- À NE PAS ACTIVER en exploitation ----------
# DEMO=1 publie des comptes de démonstration et remet les données à zéro périodiquement.
#DEMO=0
