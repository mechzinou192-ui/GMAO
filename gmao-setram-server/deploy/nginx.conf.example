# GMAO SETRAM — reverse proxy nginx (exemple TESTÉ avec nginx 1.24)
# À placer dans /etc/nginx/conf.d/gmao.conf  puis :  nginx -t && systemctl reload nginx
# Remplacer gmao.setram.local et les chemins du certificat (fournis par la DSI).

# Plafond de débit global par adresse (la limitation fine des connexions est faite par l'application)
limit_req_zone $binary_remote_addr zone=gmao:10m rate=30r/s;

# HTTP -> HTTPS
server {
    listen 80;
    server_name gmao.setram.local;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;          # nginx >= 1.25.1 : un avertissement « deprecated » est affiché, sans conséquence
    server_name gmao.setram.local;

    ssl_certificate     /etc/ssl/gmao/gmao.crt;      # certificat + chaîne intermédiaire
    ssl_certificate_key /etc/ssl/gmao/gmao.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_tickets off;

    # Photos : 10 Mo maximum par envoi (l'application refuse au-delà) ; marge pour l'en-tête
    client_max_body_size 11m;
    gzip on; gzip_types text/css application/javascript application/json image/svg+xml;

    # Ne jamais exposer la version de nginx
    server_tokens off;

    location / {
        limit_req zone=gmao burst=60 nodelay;
        proxy_pass         http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # Import Excel : envois volumineux (doit être >= IMPORT_MAX_MO du .env) et traitement plus long
    location /api/import {
        limit_req zone=gmao burst=60 nodelay;
        client_max_body_size 100m;
        proxy_pass         http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }
}
